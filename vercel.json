{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/feed" },
    { "source": "/p/:id", "destination": "/api/p?id=:id" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/t/:id", "destination": "/api/t?id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/robots?sitemap=1" },
    { "source": "/add", "destination": "/api/add" },
    { "source": "/manifest.webmanifest", "destination": "/api/manifest?site=1" },
    { "source": "/theme.css", "destination": "/api/theme" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/manifest.webmanifest", "destination": "/api/manifest" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
